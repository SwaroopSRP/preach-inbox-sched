# Local development (Leave empty to use automatic Vite proxy)
VITE_API_URL=
VITE_FRONTEND_URL=

# Production Vercel Deployment:
# 1. Point to your deployed Render backend API URL (NO trailing slash)
# VITE_API_URL=https://preach-inbox-api.onrender.com
# 2. Point to your Vercel public frontend URL (used for OAuth redirects)
# VITE_FRONTEND_URL=https://preach-inbox.vercel.app
