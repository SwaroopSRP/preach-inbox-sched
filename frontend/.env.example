# PreachInbox Frontend Environment Variables

# Local Development:
# Leave VITE_API_URL empty to let Vite proxy requests to http://localhost:3000 automatically
VITE_API_URL=
VITE_FRONTEND_URL=http://localhost:5173

# Production Deployment (Vercel):
# 1. Base URL of the deployed Render backend (NO trailing slash)
# VITE_API_URL=https://preach-inbox-api.onrender.com
# 2. Public URL of your deployed frontend (used for OAuth redirects)
# VITE_FRONTEND_URL=https://your-app.vercel.app
